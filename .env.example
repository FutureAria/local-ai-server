OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
DATABASE_URL=sqlite:///data/local_ai.sqlite3
CHROMA_PATH=data/chroma
UPLOAD_DIR=data/uploads
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_RETRIES=2
# Optional. If set, protected endpoints require X-API-Key.
LOCAL_API_KEY=
# Process-local in-memory limit for protected endpoints. Set 0 to disable.
LOCAL_RATE_LIMIT_PER_MINUTE=120
# Agent execution is blocked by default. Do not enable without a separate safety review.
AGENT_EXECUTION_ENABLED=false
# Comma-separated roots that file agent actions may read when execution is enabled.
AGENT_ALLOWED_ROOTS=.
# Read-only URL fetch for explicit http/https URLs. Browser clicks/forms are not supported.
AGENT_WEB_FETCH_ENABLED=false
# Maximum response bytes read by agent URL fetch before truncation.
AGENT_WEB_FETCH_MAX_BYTES=100000
# Maximum file bytes read by agent file preview.
AGENT_FILE_PREVIEW_MAX_BYTES=50000
# Comma-separated text extensions allowed for agent file preview.
AGENT_FILE_PREVIEW_EXTENSIONS=.txt,.md,.py,.json,.yaml,.yml,.toml,.csv,.html,.htm,.log
LOCAL_AI_SERVER_URL=http://127.0.0.1:8000
